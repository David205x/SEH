{
  "schema_version": 1,
  "harness_id": "as_you_can_search_v4",
  "tools": [
    {
      "instance_id": "search",
      "entrypoint": "tools/retriever_search/component.py:build",
      "config": {"default_topk": 10}
    }
  ],
  "prompt": {
    "instance_id": "ircot_search",
    "entrypoint": "prompt/component.py:build",
    "config": {}
  },
  "output": {
    "instance_id": "tagged_output",
    "entrypoint": "output/component.py:build",
    "config": {}
  },
  "extensions": [
    {
      "instance_id": "reason_in_documents",
      "entrypoint": "extensions/reason_in_documents/component.py:build",
      "config": {
        "topk": 10,
        "max_history_chars": 6000,
        "max_document_chars": 24000,
        "max_forced_searches": 3
      }
    }
  ]
}
