{
  "schema_version": 1,
  "harness_id": "teacher_compiler_v1",
  "role": {
    "id": "compiler",
    "version": 1
  },
  "output_contract": {
    "id": "compiler_result",
    "version": 1
  },
  "tools": [
    {
      "instance_id": "list_harness_files",
      "entrypoint": "tools/runtime/plugin.py:build",
      "config": {"kind": "list_harness_files"},
      "evolution_policy": "fixed"
    },
    {
      "instance_id": "read_harness_file",
      "entrypoint": "tools/runtime/plugin.py:build",
      "config": {"kind": "read_harness_file"},
      "evolution_policy": "fixed"
    },
    {
      "instance_id": "write_candidate_file",
      "entrypoint": "tools/runtime/plugin.py:build",
      "config": {"kind": "write_candidate_file"},
      "evolution_policy": "fixed"
    },
    {
      "instance_id": "delete_candidate_file",
      "entrypoint": "tools/runtime/plugin.py:build",
      "config": {"kind": "delete_candidate_file"},
      "evolution_policy": "fixed"
    },
    {
      "instance_id": "finalize_candidate",
      "entrypoint": "tools/runtime/plugin.py:build",
      "config": {"kind": "finalize_candidate"},
      "evolution_policy": "fixed"
    }
  ],
  "prompt": {
    "instance_id": "compiler",
    "entrypoint": "prompts/compiler/plugin.py:build",
    "config": {
      "instructions": "templates/system.md",
      "user_template": "templates/user.md"
    },
    "evolution_policy": "fixed"
  }
}
